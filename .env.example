# Modele de configuration locale. Copiez-le en .env et renseignez les valeurs :
#
#     cp .env.example .env
#
# .env n'est pas versionne. Les secrets vivaient auparavant dans src/main/resources/application.yml,
# donc dans l'historique public du depot : mot de passe de la base, secret JWT et les quatre cles
# Flickr sont a considerer comme compromis et doivent etre renouveles chez leur emetteur.

# --- Base de donnees ---------------------------------------------------------
DB_NAME=gestionstock
DB_USERNAME=gestionstock
DB_PASSWORD=changez-moi
# Port publie sur la machine hote. A changer si un PostgreSQL y tourne deja (5433, 5434...) ;
# les deux valeurs ci-dessous doivent alors s'accorder.
DB_PORT=5432
# L'application lit cette URL ; docker-compose, lui, lit DB_NAME/DB_USERNAME/DB_PASSWORD.
DB_URL=jdbc:postgresql://localhost:5432/gestionstock

# --- Jeton d'authentification ------------------------------------------------
# 64 octets encodes en base64 (JwtUtils decode la valeur) :
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=
# Duree du jeton d'acces, en millisecondes. 3600000 = 1 h.
# L'ancienne valeur, 3600, etait lue en millisecondes : les jetons expiraient en 3,6 secondes.
# Elle est passee ensuite a 24 h, faute de pouvoir renouveler un jeton sans se reconnecter.
# Une heure depuis que le jeton de rafraichissement existe : un JWT ne se revoque pas, et c'est
# sa duree qui decide combien de temps un compte ferme continue d'ouvrir les portes.
JWT_EXPIRATION_MS=3600000
# Duree du jeton de rafraichissement. 2592000000 = 30 jours.
# Celui-la vit en base : il se revoque, et c'est ce qui permet de garder le jeton d'acces court.
JWT_REFRESH_EXPIRATION_MS=2592000000

# --- Front (CORS) -------------------------------------------------------------
# Les origines autorisees a appeler l'API depuis un navigateur, separees par des virgules.
# Jamais « * » : l'etoile ouvrirait l'API a n'importe quelle page du web.
# En developpement, le serveur Angular ; en production, l'origine du site.
CORS_ORIGINES=http://localhost:4200,http://127.0.0.1:4200

# --- Hebergement des images (Flickr) -----------------------------------------
# Laissez vide tant que de nouvelles cles n'ont pas ete emises : seul l'envoi de photos
# d'article s'en sert, le reste de l'application demarre sans.
FLICKR_API_KEY=
FLICKR_API_SECRET=
FLICKR_APP_KEY=
FLICKR_APP_SECRET=

# --- Divers ------------------------------------------------------------------
# Le fuseau dans lequel se lisent les journees : l'etat de caisse du 21 septembre est celui du
# jour civil local, pas celui de l'horloge du serveur, qui tourne en UTC.
FUSEAU_HORAIRE=Africa/Douala
SERVER_PORT=9092
ADMINER_PORT=8081
# --- Notifications par courriel ----------------------------------------------
# Ce fichier est VERSIONNE : il ne porte que des exemples. Les vraies valeurs vont dans .env,
# qui ne l'est pas.
#
# Tant que EMAIL_HOST est vide, les courriels s'accumulent dans la file sans partir et sans
# echouer : ils s'enverront tels quels le jour ou ces variables seront renseignees.
#
# Avec Gmail, EMAIL_PASSWORD n'est pas le mot de passe du compte mais un « mot de passe
# d'application » a generer dans les parametres de securite Google, et a traiter comme un
# secret a part entiere : il ouvre l'envoi de courriels au nom de l'adresse.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=adresse@exemple.test
EMAIL_PASSWORD=
# L'adresse qui figure comme expediteur. Vide, c'est celle du compte SMTP ci-dessus.
EMAIL_FROM=
#
# Le super-administrateur, cree au demarrage.
#
# Le rang au-dessus des entreprises : celui qui les cree et qui peut regarder au-dela de l'une
# d'elles. C'est l'editeur, pas le gerant — ROLE_ADMIN administre sa seule entreprise.
#
# Les trois vides, rien ne se passe. C'est le cas d'une installation deja amorcee, et c'est la
# valeur par defaut : ce fichier ne cree personne tant qu'on ne le lui demande pas.
#
# Renseignees, le compte est cree au premier demarrage qui suit, puis plus jamais touche. Changer
# SUPER_ADMIN_MOTDEPASSE ensuite ne reinitialise rien : le mot de passe se change dans
# l'application, et l'environnement ne doit pas defaire en silence ce qu'on y a fait.
#
# Le mot de passe fait au moins douze caracteres, sans quoi le compte n'est pas cree et le journal
# le dit. Ce compte peut tout faire, sur toutes les entreprises, et son identifiant est connu de
# qui lit ce fichier.
SUPER_ADMIN_USERNAME= poudjoum Rodrigue
SUPER_ADMIN_EMAIL=poudjoumr@gmail.com
SUPER_ADMIN_MOTDEPASSE=Jumpy07@2668

#
# La terminaison TLS.
#
# Pourquoi du HTTPS sur un reseau local, ou personne n'ecoute : le navigateur reserve aux origines
# sures tout un pan de ses capacites. `crypto.randomUUID` n'y existe pas en clair — l'encaissement
# a echoue dessus en production — et le service worker ne s'enregistre pas du tout. L'application
# est declaree installable et capable de fonctionner hors ligne ; en HTTP elle n'est ni l'un ni
# l'autre.
#
# SERVER_NAME : l'hote seul, ni schema ni port. L'adresse du serveur sur le reseau du magasin,
# ou le nom de domaine le jour ou il y en aura un.
SERVER_NAME=192.168.1.100

# TLS_MODE : `internal` pour l'autorite de certification que Caddy genere lui-meme — le mode du
# reseau local, puisque aucune autorite publique ne peut certifier une adresse privee. Les
# appareils du magasin doivent alors installer son certificat racine, une fois chacun (voir le
# README). Remplacer par une adresse de courriel le jour d'un vrai nom de domaine : Caddy prendra
# alors un certificat Let's Encrypt, et plus rien n'est a installer nulle part.
TLS_MODE=internal

HTTPS_PORT=9443
HTTPS_BIND=0.0.0.0

# Une fois le HTTPS en service et l'autorite installee sur les appareils, refermer les portes en
# clair : l'application et l'API cessent alors d'etre joignables autrement que par Caddy.
#
#   WEB_BIND=127.0.0.1
#   APP_BIND=127.0.0.1
#
# A ne faire qu'apres avoir verifie que le HTTPS fonctionne depuis un appareil du magasin — sans
# quoi plus personne n'entre.
